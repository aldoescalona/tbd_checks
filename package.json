{
  "name": "tbd-checks-ejemplo",
  "version": "0.1.0",
  "description": "Proyecto básico para ejemplificar checks automáticos en Trunk-based Development",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand",
    "lint": "eslint src tests",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0"
  }
}
